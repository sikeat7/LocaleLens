{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocaleLens configuration",
  "description": "Local browser-based localization layout checks. See docs/configuration.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "$schema": { "type": "string" },
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "Bare domain or HTTP(S) URL. Public domains default to HTTPS; localhost and loopback default to HTTP."
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "pattern": "^/" }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["baseline", "expanded", "rtl", "expanded-rtl"] }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "oneOf": [
          { "enum": ["desktop", "mobile", "tablet"] },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "width", "height"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,40}$" },
              "width": { "type": "integer", "minimum": 240, "maximum": 3840 },
              "height": { "type": "integer", "minimum": 240, "maximum": 2160 }
            }
          }
        ]
      }
    },
    "expansion": { "type": "integer", "minimum": 10, "maximum": 200, "default": 40 },
    "locale": { "type": "string", "minLength": 1, "default": "en-US" },
    "timeout": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 30000 },
    "settle": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 300 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2 },
    "output": { "type": "string", "minLength": 1, "default": "localelens-report" },
    "failOn": { "enum": ["error", "warning", "none"], "default": "error" },
    "ignore": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "mask": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["horizontal-overflow", "clipped-text", "page-error"] }
    },
    "screenshots": { "type": "boolean", "default": true },
    "maxFindings": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 },
    "waitFor": { "type": "string", "minLength": 1 },
    "storageState": { "type": "string", "minLength": 1 },
    "executablePath": { "type": "string", "minLength": 1 }
  }
}
